    <!-- Onboarding: Welcome -->
    <string name="onboarding_welcome_title">Welcome to BlinkWell</string>
    <string name="onboarding_welcome_desc">Your friendly helper for happy, rested eyes. BlinkWell reminds you to blink while you use your phone so your eyes don\'t get tired or dry.</string>
    <string name="onboarding_get_started">Get Started</string>

    <!-- Onboarding: How It Works -->
    <string name="onboarding_how_it_works_title">How BlinkWell Works</string>
    <string name="onboarding_how_it_works_desc">Using your front camera, BlinkWell counts your blinks to help you rest your eyes. No photos or videos are ever saved or shared.</string>
    <string name="onboarding_privacy_promise">100% Safe &amp; Private • Zero Photos Saved</string>

    <!-- Onboarding: Consent -->
    <string name="onboarding_consent_title">Simple Choices</string>
    <string name="onboarding_consent_desc">Choose what you want BlinkWell to do. You can change this anytime.</string>
    <string name="consent_monitor_title">Count my eye blinks</string>
    <string name="consent_monitor_desc">Needed to count your blinks and remind you when your eyes are tired.</string>
    <string name="consent_research_title">Help Improve BlinkWell</string>
    <string name="consent_research_desc">Share anonymous numbers to help study healthy screen habits (optional).</string>

