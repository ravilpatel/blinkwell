    <!-- Info / Education Dialog -->
    <string name="info_dialog_title">👁️ Why We Need to Blink</string>
    <string name="info_dialog_subtitle">Keeping your eyes happy when using screens</string>
    <string name="info_dialog_what_title">How BlinkWell Helps</string>
    <string name="info_dialog_what_desc">BlinkWell counts your blinks using the camera to make sure your eyes stay healthy. It never saves or shares any pictures.</string>
    <string name="info_dialog_why_title">Why Blinking is Good</string>
    <string name="info_dialog_why_desc">When we stare at screens, we forget to blink! Every time you blink, your eyelids wash your eyes with tears to keep them wet and clean. If you don\'t blink, your eyes get dry, tired, and itchy.</string>
    <string name="info_dialog_tip">💡 Tip: Try to blink 15 times every minute, and look away to rest your eyes!</string>
    <string name="info_dialog_btn">Got It</string>

    <!-- Background Usage & Battery Optimization Permission -->
    <string name="bg_permission_dialog_title">🛡️ Background Reminders</string>
    <string name="bg_permission_dialog_subtitle">Needed for Reminders While Playing or Browsing</string>
    <string name="bg_permission_dialog_desc">To remind you to blink while you use other apps or watch videos, BlinkWell needs permission to run in the background.</string>
    <string name="bg_permission_privacy_header">Safe &amp; Battery-Friendly:</string>
    <string name="bg_permission_rule_screen_off">🔒 Screen Off: The camera is never used when your screen is locked or turned off.</string>
    <string name="bg_permission_rule_5s_noface">⚡ Saves Battery: Turns off camera if no face is in front of the phone.</string>
    <string name="bg_permission_btn_allow">Allow Reminders</string>
    <string name="bg_permission_btn_skip">Not Now</string>
