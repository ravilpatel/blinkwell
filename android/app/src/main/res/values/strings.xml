    <!-- Info / Education Dialog -->
    <string name="info_dialog_title">👁️ Why Blinking Matters</string>
    <string name="info_dialog_subtitle">Protecting your eye health during screen time</string>
    <string name="info_dialog_what_title">What BlinkWell Does</string>
    <string name="info_dialog_what_desc">BlinkWell uses on-device camera analysis to measure your real-time blink rate without recording or saving any videos or images.</string>
    <string name="info_dialog_why_title">Preventing Dry Eyes &amp; Vision Issues</string>
    <string name="info_dialog_why_desc">When looking at digital screens, our natural blink frequency drops by up to 60%%. Each blink spreads a vital lubricating tear film over the cornea. Reduced blinking causes tear evaporation, dry eye syndrome, digital eye strain (DES), blurred vision, and chronic eye irritation.</string>
    <string name="info_dialog_tip">💡 Recommended Rate: 15–20 blinks/min. Remember the 20-20-20 rule!</string>
    <string name="info_dialog_btn">Got It</string>

    <!-- Background Usage & Battery Optimization Permission -->
    <string name="bg_permission_dialog_title">🛡️ Background Monitoring Permission</string>
    <string name="bg_permission_dialog_subtitle">Essential for Continuous Monitoring Mode</string>
    <string name="bg_permission_dialog_desc">To deliver real-time blink rate monitoring and wellness alerts while you use other apps, BlinkWell needs permission to run in the background without battery saver interruptions.</string>
    <string name="bg_permission_privacy_header">Built-in Battery &amp; Privacy Guarantees:</string>
    <string name="bg_permission_rule_screen_off">🔒 Screen Off Safety: Camera is NEVER used whenever your screen is off or locked.</string>
    <string name="bg_permission_rule_5s_noface">⚡ 5-Second Power Saver: If screen is on but no face is visible within the first 5 seconds, the camera immediately unbinds to save battery.</string>
    <string name="bg_permission_btn_allow">Allow Background Usage</string>
    <string name="bg_permission_btn_skip">Not Now (Start Anyway)</string>
    <string name="permission_battery_opt_title">Background Battery Optimization</string>
    <string name="permission_battery_opt_reason">Allows uninterrupted real-time eye health monitoring while using other apps.</string>
    <string name="settings_battery_opt_title">Background Execution</string>
    <string name="settings_battery_opt_summary_exempt">Unrestricted • Background monitoring active</string>
    <string name="settings_battery_opt_summary_restricted">Restricted • Tap to allow background monitoring</string>
    <string name="settings_battery_opt_btn">Configure Background Permission</string>
    <string name="settings_section_power">Battery &amp; Power Management</string>
    <string name="settings_battery_guard_title">Low Battery &amp; Battery Saver Guard</string>
    <string name="settings_battery_guard_subtitle">Prevent battery drain during low power</string>
    <string name="settings_battery_guard_threshold_label">Pause Threshold: %d%%</string>
    <string name="settings_battery_guard_desc">Monitoring Mode will not turn on and will pause automatically when battery is below %d%% (while not charging) or Battery Saver mode is on.</string>
    <string name="home_battery_guard_alert_title">⚡ Battery Saver Guard Active</string>
    <string name="home_battery_guard_alert_body">Monitoring Mode cannot turn on because your battery is below %1$d%% (%2$d%%) or Battery Saver is active. Plug in your charger or configure this in Settings.</string>
    <string name="home_battery_guard_dismiss">Got It</string>

