    <!-- Onboarding: Welcome -->
    <string name="onboarding_welcome_title">Welcome to BlinkWell</string>
    <string name="onboarding_welcome_desc">Your personal companion for eye health and screen-time wellness. BlinkWell helps reduce digital eye strain by monitoring your blink rate.</string>
    <string name="onboarding_get_started">Get Started</string>

    <!-- Onboarding: How It Works -->
    <string name="onboarding_how_it_works_title">How BlinkWell Works</string>
    <string name="onboarding_how_it_works_desc">Using your front camera, BlinkWell detects your blink patterns completely on-device. No raw video or photos are ever recorded, stored, or transmitted.</string>
    <string name="onboarding_privacy_promise">100% On-Device Face Analysis • Zero Video Saved</string>

    <!-- Onboarding: Consent -->
    <string name="onboarding_consent_title">Your Privacy &amp; Consent</string>
    <string name="onboarding_consent_desc">Please review and select your privacy preferences. You can modify these anytime in Settings.</string>
    <string name="consent_monitor_title">Allow blink rate monitoring</string>
    <string name="consent_monitor_desc">Required to measure blink rates and deliver low-blink wellness alerts.</string>
    <string name="consent_research_title">Share anonymized research data</string>
    <string name="consent_research_desc">Help eye-health researchers by uploading anonymous aggregate blink metrics (optional).</string>
    <string name="privacy_policy_link">Read our Privacy Policy</string>

    <!-- Onboarding: Screening & Cohort -->
    <string name="screening_title">Personalize Your Vision Care</string>
    <string name="screening_subtitle">What best describes your daily screen activity?</string>
    <string name="screening_desc">This helps calibrate ergonomic fatigue thresholds and study models.</string>
    <string name="cohort_software_title">Software Engineer / Tech</string>
    <string name="cohort_software_desc">Continuous code editor, IDE &amp; terminal focus with intense staring blocks.</string>
    <string name="cohort_student_title">Student / Academic</string>
    <string name="cohort_student_desc">Prolonged reading, coursework, research &amp; video lectures.</string>
    <string name="cohort_general_title">General Screen Use</string>
    <string name="cohort_general_desc">Everyday browsing, messaging, media &amp; varied device habits.</string>

    <!-- Onboarding: Monitoring Mode Choice -->
    <string name="mode_choice_title">Choose Operational Mode</string>
    <string name="mode_choice_desc">Select your default eye wellness mode (you can change this anytime):</string>
    <string name="mode_burst_title">Burst Mode (5 min)</string>
    <string name="mode_burst_desc">5-minute focused assessment while using your phone. Calculates final BPM at 5 minutes with zero mid-session alerts.</string>
    <string name="mode_monitoring_title">Monitoring Mode</string>
    <string name="mode_monitoring_desc">Continuous real-time blink rate monitoring with live speedometer and gentle wellness notifications.</string>
    <string name="mode_background_title">Run in Background</string>
    <string name="mode_background_desc">Periodically monitors your blink rate while you use other apps via an ongoing notification. Pauses immediately when screen turns off.</string>
    <string name="mode_app_only_title">Only Check in App</string>
    <string name="mode_app_only_desc">Monitors blink rate only while BlinkWell is actively open on your screen. Zero background battery or CPU use.</string>

    <!-- Onboarding: Permissions -->
    <string name="permissions_title">Required Permissions</string>
    <string name="permissions_desc">BlinkWell requires camera access to detect blinks, and notification access for gentle wellness reminders.</string>
    <string name="permission_camera_reason">Camera is used strictly for real-time, on-device eye blink detection.</string>
    <string name="permission_notification_reason">Notifications deliver friendly alerts when your blink rate is low.</string>
    <string name="grant_permissions">Grant Permissions</string>

