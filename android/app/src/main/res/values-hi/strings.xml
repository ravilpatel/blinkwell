    <!-- Onboarding: Welcome -->
    <string name="onboarding_welcome_title">BlinkWell में आपका स्वागत है</string>
    <string name="onboarding_welcome_desc">स्क्रीन समय में आपकी आँखों की सेहत के लिए आपका निजी साथी। BlinkWell पलक झपकाने की दर की निगरानी करके डिजिटल आँखों के तनाव को कम करने में मदद करता है।</string>
    <string name="onboarding_get_started">शुरू करें</string>

    <!-- Onboarding: How It Works -->
    <string name="onboarding_how_it_works_title">BlinkWell कैसे काम करता है</string>
    <string name="onboarding_how_it_works_desc">सामने के कैमरे का उपयोग करके, BlinkWell पूरी तरह से आपके डिवाइस पर ही पलक झपकाने के पैटर्न का पता लगाता है। कोई भी वीडियो या फोटो कभी रिकॉर्ड या सहेजा नहीं जाता है।</string>
    <string name="onboarding_privacy_promise">100% ऑन-डिवाइस विश्लेषण • कोई वीडियो सहेजा नहीं गया</string>

    <!-- Onboarding: Consent -->
    <string name="onboarding_consent_title">आपकी गोपनीयता और सहमति</string>
    <string name="onboarding_consent_desc">कृपया अपनी गोपनीयता प्राथमिकताएँ चुनें। आप इन्हें कभी भी सेटिंग्स में बदल सकते हैं।</string>
    <string name="consent_monitor_title">पलक झपकाने की निगरानी की अनुमति दें</string>
    <string name="consent_monitor_desc">पलक झपकाने की दर मापने और स्वास्थ्य अलर्ट देने के लिए आवश्यक है।</string>
    <string name="consent_research_title">गुमनाम अनुसंधान डेटा साझा करें</string>
    <string name="consent_research_desc">गुमनाम एकत्रित मेट्रिक्स अपलोड करके शोधकर्ताओं की सहायता करें (वैकल्पिक)।</string>
    <string name="privacy_policy_link">हमारी गोपनीयता नीति पढ़ें</string>

    <!-- Onboarding: Monitoring Mode Choice -->
    <string name="mode_choice_title">निगरानी मोड चुनें</string>
    <string name="mode_choice_desc">चुनें कि आप BlinkWell द्वारा आँखों की देखभाल कैसे चाहते हैं:</string>
    <string name="mode_background_title">पृष्ठभूमि (Background) में चलाएं</string>
    <string name="mode_background_desc">अन्य ऐप्स का उपयोग करते समय भी सूचना के माध्यम से समय-समय पर निगरानी करता है। स्क्रीन बंद होने पर तुरंत रुक जाता है।</string>
    <string name="mode_app_only_title">केवल ऐप खुला होने पर जांचें</string>
    <string name="mode_app_only_desc">केवल तभी निगरानी करता है जब BlinkWell स्क्रीन पर सक्रिय रूप से खुला हो। शून्य बैकग्राउंड बैटरी खपत।</string>

    <!-- Onboarding: Permissions -->
    <string name="permissions_title">आवश्यक अनुमतियाँ</string>
    <string name="permissions_desc">BlinkWell को पलकें पहचानने के लिए कैमरा एक्सेस और स्वास्थ्य अलर्ट के लिए सूचना (Notification) एक्सेस की आवश्यकता है।</string>
    <string name="permission_camera_reason">कैमरे का उपयोग केवल ऑन-डिवाइस पलक झपकाने की पहचान के लिए किया जाता है।</string>
    <string name="permission_notification_reason">कम पलक झपकाने पर नोटिफिकेशन द्वारा याद दिलाया जाता है।</string>
    <string name="grant_permissions">अनुमतियाँ दें</string>

