    <string name="burst_help_point2_title">विस्तृत आई स्कोर</string>
    <string name="burst_help_point2_desc">कुल पलकें, प्रति मिनट औसत दर और स्वस्थ 15–20 BPM लक्ष्य की तुलना दिखाता है।</string>
    <string name="burst_help_point3_title">बिना रुकावट और पूर्णतः निजी</string>
    <string name="burst_help_point3_desc">स्क्रीन पर बिना रुकावट के चुपचाप चलता है। 100% सुरक्षित, कोई फोटो या वीडियो सहेजा नहीं जाता।</string>

    <!-- Monitoring Mode Help Dialog -->
    <string name="monitoring_help_dialog_title">मॉनिटरिंग मोड कैसे काम करता है</string>
    <string name="monitoring_help_point1_title">1 मिनट की शुरुआती जांच</string>
    <string name="monitoring_help_point1_desc">शुरू होने पर कैमरा पहली बार लगातार 1 मिनट तक आपकी पलकें गिनता है।</string>
    <string name="monitoring_help_point2_title">रंग-बिरंगा फीडबैक</string>
    <string name="monitoring_help_point2_desc">कैमरा बंद होकर नोटिफिकेशन भेजता है। स्वस्थ दर पर हरा रहता है, कम होने पर लाल हो जाता है।</string>
    <string name="monitoring_help_point3_title">2 मिनट विश्राम और 30s जांच</string>
    <string name="monitoring_help_point3_desc">बैटरी बचाने के लिए कैमरा 2 मिनट बंद रहता है, फिर केवल 30 सेकंड के लिए दोबारा जांच करता है।</string>
    <string name="monitoring_help_point4_title">स्क्रीन और बैटरी सुरक्षा</string>
    <string name="monitoring_help_point4_desc">स्क्रीन बंद होने पर रुक जाता है, अनलॉक होने पर फिर शुरू होता है। बैटरी कम होने पर रुक कर सूचना देता है।</string>

